@page "/routes/edit/{RouteId:int}"
@rendermode InteractiveServer
@using IvanovKursovaya.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Administrator")]
@inject IDbContextFactory<TicketContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Редактировать маршрут</PageTitle>

<h1>Редактировать маршрут</h1>

@if (Loading)
{
    <p><em>Загрузка...</em></p>
}
else if (Route is null)
{
    <p>Маршрут не найден.</p>
}
else
{
    <EditForm Model="Route" OnValidSubmit="UpdateRoute" FormName="edit-route">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Откуда</label>
            <InputText @bind-Value="Route.FromCity" class="form-control" />
            <ValidationMessage For="() => Route.FromCity" />
        </div>
        <div class="mb-3">
            <label>Куда</label>
            <InputText @bind-Value="Route.ToCity" class="form-control" />
            <ValidationMessage For="() => Route.ToCity" />
        </div>
        <div class="mb-3">
            <label>Расстояние (км)</label>
            <InputNumber @bind-Value="Route.DistanceKm" class="form-control" />
            <ValidationMessage For="() => Route.DistanceKm" />
        </div>
        <div class="mb-3">
            <label>Изображение маршрута</label>
            <InputFile OnChange="UploadImage" accept="image/*" class="form-control" />
        </div>

        @if (!string.IsNullOrEmpty(Route.ImagePath))
        {
            <div class="mb-3">
                <img src="@Route.ImagePath" alt="preview" style="max-height:150px;" />
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@Loading">Сохранить</button>
        <a href="/routes" class="btn btn-secondary">Отмена</a>
    </EditForm>
}

@code {
    [Parameter] public int RouteId { get; set; }

    private Route? Route;
    private bool Loading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            Route = await context.Routes.FindAsync(RouteId);
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        Loading = true;
        try
        {
            var file = e.File;
            var ext = Path.GetExtension(file.Name);
            var fileName = $"{Guid.NewGuid()}{ext}";
            var path = Path.Combine("wwwroot", "uploads", fileName);
            await using var fs = new FileStream(path, FileMode.Create);
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs);
            Route!.ImagePath = $"/uploads/{fileName}";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task UpdateRoute()
    {
        Loading = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            context.Routes.Update(Route!);
            await context.SaveChangesAsync();
            Navigation.NavigateTo("/routes");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }
}
