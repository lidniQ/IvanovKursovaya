@page "/schedules/create"
@rendermode InteractiveServer
@using IvanovKursovaya.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Administrator")]
@inject IDbContextFactory<TicketContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Добавить расписание</PageTitle>

<h1>Добавить расписание</h1>

<EditForm Model="Schedule" OnValidSubmit="AddSchedule" FormName="create-schedule">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Маршрут</label>
        <InputSelect @bind-Value="Schedule.RouteId" class="form-select">
            <option value="0">-- Выберите маршрут --</option>
            @foreach (var r in routes)
            {
                <option value="@r.RouteId">@r.FromCity → @r.ToCity (@r.DistanceKm км)</option>
            }
        </InputSelect>
    </div>
    <div class="mb-3">
        <label>Дата отправления</label>
        <InputDate @bind-Value="Schedule.DepartureDate" class="form-control" />
        <ValidationMessage For="() => Schedule.DepartureDate" />
    </div>
    <div class="mb-3">
        <label>Время отправления (ЧЧ:ММ)</label>
        <input type="time" class="form-control" value="@DepartureTimeStr" @onchange="@(e => DepartureTimeStr = e.Value?.ToString() ?? "08:00")" />
    </div>
    <div class="mb-3">
        <label>Время прибытия (ЧЧ:ММ)</label>
        <input type="time" class="form-control" value="@ArrivalTimeStr" @onchange="@(e => ArrivalTimeStr = e.Value?.ToString() ?? "16:00")" />
    </div>
    <div class="mb-3">
        <label>Перевозчик</label>
        <InputText @bind-Value="Schedule.Carrier" class="form-control" />
        <ValidationMessage For="() => Schedule.Carrier" />
    </div>
    <div class="mb-3">
        <label>Количество мест</label>
        <InputNumber @bind-Value="Schedule.TotalSeats" class="form-control" />
        <ValidationMessage For="() => Schedule.TotalSeats" />
    </div>
    <div class="mb-3">
        <label>Цена (₽)</label>
        <InputNumber @bind-Value="Schedule.Price" class="form-control" />
        <ValidationMessage For="() => Schedule.Price" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary" disabled="@Loading">Сохранить</button>
    <a href="@($"/schedules?routeid={RouteId}")" class="btn btn-secondary">Отмена</a>
</EditForm>

@code {
    [SupplyParameterFromQuery]
    public int? RouteId { get; set; }

    [SupplyParameterFromForm]
    private Schedule Schedule { get; set; } = new() { DepartureDate = DateTime.Today.AddDays(1) };

    private List<Route> routes = new();
    private bool Loading = true;
    private string? errorMessage;
    private string DepartureTimeStr = "08:00";
    private string ArrivalTimeStr = "16:00";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            routes = await context.Routes.ToListAsync();
            if (RouteId.HasValue)
                Schedule.RouteId = RouteId.Value;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task AddSchedule()
    {
        Loading = true;
        try
        {
            if (TimeSpan.TryParse(DepartureTimeStr, out var dep))
                Schedule.DepartureTime = dep;
            if (TimeSpan.TryParse(ArrivalTimeStr, out var arr))
                Schedule.ArrivalTime = arr;

            await using var context = await DbFactory.CreateDbContextAsync();
            await context.Schedules.AddAsync(Schedule);
            await context.SaveChangesAsync();
            Navigation.NavigateTo($"/schedules?routeid={Schedule.RouteId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }
}
