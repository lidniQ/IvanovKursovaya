@page "/cities/edit/{CityId:int}"
@rendermode InteractiveServer
@using IvanovKursovaya.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Administrator")]
@inject IDbContextFactory<TicketContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Редактировать город</PageTitle>

<h1>Редактировать город</h1>

@if (Loading)
{
    <p><em>Загрузка...</em></p>
}
else if (City is null)
{
    <p>Город не найден.</p>
    <a href="/cities" class="btn btn-secondary">Назад</a>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="City" OnValidSubmit="UpdateCity">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Название города</label>
                    <InputText @bind-Value="City.CityName" class="form-control" />
                    <ValidationMessage For="() => City.CityName" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a href="/cities" class="btn btn-secondary ms-2">Отмена</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int CityId { get; set; }

    private City? City;
    private bool Loading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            City = await context.Cities.FindAsync(CityId);
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task UpdateCity()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            context.Cities.Update(City!);
            await context.SaveChangesAsync();
            Navigation.NavigateTo("/cities");
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при сохранении: {ex.Message}";
        }
    }
}
