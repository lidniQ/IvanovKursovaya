@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="top-navbar navbar navbar-expand-lg">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="navbar-icon">🚌</span> Автобусные билеты
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        Главная
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="routes">
                        Маршруты
                    </NavLink>
                </li>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="mytickets">
                                Мои билеты
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="alltickets">
                                Все билеты
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="excel">
                                Excel
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="statistics">
                                Статистика
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="Account/Manage">
                                👤 @context.User.Identity?.Name
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post" class="d-inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="nav-link btn btn-link">
                                    Выйти
                                </button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="Account/Register">
                                Регистрация
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link btn-login" href="Account/Login">
                                Войти
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
